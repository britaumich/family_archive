        <li class="nav-item px-3 pt-2 pb-1">
          <span class="text-uppercase small fw-semibold text-white-50"><%= t('menu.navbar.items') %></span>
        </li>

        <li class="nav-item">
          <%= link_to t('menu.navbar.all_items'), items_path(item_type: 'photo'), class: 'nav-link navbar_dropdown_item ps-4 pe-3' %>
