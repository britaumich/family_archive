        <%= image_tag 'family.jpg', alt: 'Family Archive Logo', class: 'logo-brand' %>
        <div class="nav-title h-100">
          <%= t('menu.navbar.title') %>
        </div>
      </div>
    <% end %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarBurgerMenu" aria-controls="navbarBurgerMenu" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
    </button>
    <!-- this is regular navbar-->
    <div class="collapse navbar-collapse d-none d-md-block">
      <% if authenticated? %>
        <div class="nav-item dropdown navbar_dropdown_item h-100 px-2 rounded-0 border-0">
          <a class="nav-link h-100 d-flex align-items-center fs-5 focus-ring border-0 rounded-2" style="--bs-focus-ring-color:#E5E5E5;" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <%= t('menu.navbar.items') %>
          </a>
          <ul class="dropdown-menu bg-primary rounded-0 navbar_dropdown_item">
            <li>
              <%= link_to t('menu.navbar.all_items'), items_path(item_type: 'photo'), class: 'dropdown-item navbar_dropdown_item' %>
            </li>
            <li>
              <%= link_to t('menu.navbar.videos'), items_path(item_type: 'video'), class: 'dropdown-item navbar_dropdown_item' %>
            </li>
            <li>
              <%= link_to t('menu.navbar.documents'), items_path(item_type: 'document'), class: 'dropdown-item navbar_dropdown_item' %>
            </li>
            <li class="dropdown-submenu">
              <a class="dropdown-item navbar_dropdown_item dropdown-toggle" href="#">
                <%= t('menu.navbar.family_pictures') %>
              </a>
              <ul class="dropdown-menu bg-primary rounded-0 navbar_dropdown_item">
                <% all_families.each do |family| %>
                  <li>
                    <%= link_to family.translated_name, family_pictures_items_path(family), class: 'dropdown-item navbar_dropdown_item' %>
                  </li>
                <% end %>
              </ul>
            </li>
          </ul>
        </div>
        <% if policy(AdminUser).index? %>
          <div class="nav-item dropdown navbar_dropdown_item h-100 px-2 rounded-0 border-0">
            <a class="nav-link h-100 d-flex align-items-center fs-5 focus-ring border-0 rounded-2" style="--bs-focus-ring-color:#E5E5E5;" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <%= t('menu.navbar.admin') %>
            </a>
            <ul class="dropdown-menu bg-primary rounded-0 navbar_dropdown_item">
              <li>
                <%= link_to t('menu.navbar.upload_files'), upload_files_page_path, class: 'dropdown-item navbar_dropdown_item' %>
