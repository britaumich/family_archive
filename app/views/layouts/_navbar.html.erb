                  data-bs-toggle="collapse"
                  data-bs-target="#mobileFamilyPicturesMenu"
                  aria-expanded="false"
                  aria-controls="mobileFamilyPicturesMenu">
            <span><%= t('menu.navbar.family_pictures') %></span>
            <span class="small">+</span>
          </button>
          <div class="collapse" id="mobileFamilyPicturesMenu" data-bs-parent="#navbarBurgerMenu">
