<%= form_with(model: tag_type, data: { controller: "autosubmit", autosubmit_target: "form" }) do |form| %>
  <% if tag_type.errors.any? %>
    <div class="text-danger">
      <h2><%= t('forms.errors.header', count: tag_type.errors.count) %></h2>
      <ul>
        <% tag_type.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <div class="body-bold-text mb-2">
      <%= t('forms.labels.create_tag_type') %>
    </div>
    <%= form.label :name_en, t('activerecord.attributes.tag_type.name') + ' (' + t('language.en') + ')', class: "nowrap" %>
    <div class="d-flex flex-row justify-content-start align-items-center gap-3 mb-2">
      <%= form.text_field :name_en, placeholder: t('forms.placeholders.name') + ' (' + t('language.en') + ')', class: "w-50", required: true %>
    </div>
    <%= form.label :name_ru, t('activerecord.attributes.tag_type.name') + ' (' + t('language.ru') + ')', class: "nowrap" %>
    <div class="d-flex flex-row justify-content-start align-items-center gap-3">
      <%= form.text_field :name_ru, placeholder: t('forms.placeholders.name') + ' (' + t('language.ru') + ')', class: "w-50" %>
    </div>
    <div class="d-flex flex-row justify-content-start align-items-center gap-3">
      <%= form.submit tag_type.persisted? ? t('forms.buttons.update') : t('forms.buttons.create') %>
      <%= link_to t('forms.cancel'), tag_types_path, class: "link_to" %>
    </div>
  </div>
<% end %>
