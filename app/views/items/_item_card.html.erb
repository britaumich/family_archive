<%= turbo_frame_tag "picture_#{item.id}" do %>
  <% item_navigation_params = {} %>
  <% item_navigation_params[:return_path] = navigation_return_path if local_assigns[:navigation_return_path].present? %>
  <% item_navigation_params[:item_ids] = navigation_item_ids if local_assigns[:navigation_item_ids].present? %>
  <% item_show_path = item_path(item, item_navigation_params) %>
  <div class="card h-100 shadow-sm">
    <% if item.file.attached? %>
      <% if item.file.content_type.start_with?('image/') %>
        <a href="<%= url_for(item.file) %>" 
          data-lightbox="gallery" 
          data-gallery="items-gallery"
          data-title="<%= [strip_tags(item.caption), item.tags.map(&:translated_name).join(', ')].reject(&:blank?).join(' - ') %>">
          <%= image_tag item.thumb_medium || item.file, 
              class: "card-img-top lightbox-image", 
              style: "height: 250px; object-fit: cover;",
              alt: "Item #{item.id}" %>
        </a>
      <% elsif item.file.content_type.start_with?('video/') %>
        <div class="position-relative">
          <video class="card-img-top" 
                 style="height: 250px; object-fit: cover; width: 100%;" 
                 controls 
                 controlslist="nodownload"
                 preload="metadata"
                 playsinline
                 <% if item.thumb_medium %>poster="<%= url_for(item.thumb_medium) %>"<% end %>>
            <%= content_tag :source, "", src: url_for(item.file), type: item.file.content_type %>
            <!-- Fallback for browsers that don't support the primary format -->
            <% if item.file.content_type == 'video/quicktime' %>
              <%= content_tag :source, "", src: url_for(item.file) %>
            <% end %>
            Your browser does not support the video tag.
          </video>
          <!-- Lightbox button positioned over video but not blocking controls -->
          <a href="<%= url_for(item.file) %>" 
            data-lightbox="gallery" 
            data-gallery="items-gallery"
            data-title="<%= [strip_tags(item.caption), item.tags.map(&:translated_name).join(', ')].reject(&:blank?).join(' - ') %>"
            data-type="video"
            class="btn btn-outline-light btn-sm position-absolute"
            style="top: 8px; right: 8px; z-index: 10;"
            title="Open in lightbox">
            <i class="bi bi-arrows-fullscreen"></i>
          </a>
        </div>
      <% elsif item.file.content_type == 'application/pdf' %>
        <%= link_to url_for(item.file), target: "_blank", rel: "noopener noreferrer", class: "text-decoration-none" do %>
          <div class="card-img-top d-flex flex-column align-items-center justify-content-center bg-light" style="height: 250px;">
            <i class="bi bi-file-earmark-pdf fs-1 text-danger"></i>
            <span class="text-muted mt-2"><%= t('views.items.file_types.pdf_document') %></span>
            <small class="text-muted"><%= number_to_human_size(item.file.blob.byte_size) %></small>
          </div>
        <% end %>
      <% elsif item.file.content_type.start_with?('text/') || 
               ['application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                'application/msword',
                'application/vnd.oasis.opendocument.text',
                'application/rtf'].include?(item.file.content_type) %>
        <%= link_to url_for(item.file), target: "_blank", rel: "noopener noreferrer", class: "text-decoration-none" do %>
          <div class="card-img-top d-flex flex-column align-items-center justify-content-center bg-light" style="height: 250px;">
            <% if item.file.content_type.start_with?('text/') %>
              <i class="bi bi-file-earmark-text fs-1 text-primary"></i>
              <span class="text-muted mt-2"><%= t('views.items.file_types.text_document') %></span>
            <% else %>
              <i class="bi bi-file-earmark-word fs-1 text-info"></i>
              <span class="text-muted mt-2"><%= t('views.items.file_types.word_document') %></span>
            <% end %>
            <small class="text-muted"><%= number_to_human_size(item.file.blob.byte_size) %></small>
          </div>
        <% end %>
      <% else %>
        <%= link_to item_show_path, class: "text-decoration-none" do %>
          <div class="card-img-top d-flex flex-column align-items-center justify-content-center bg-light" style="height: 250px;">
            <i class="bi bi-file-text fs-1 text-muted"></i>
            <span class="text-muted mt-2">Unknown File</span>
            <small class="text-muted"><%= number_to_human_size(item.file.blob.byte_size) %></small>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <%= link_to item_show_path, class: "text-decoration-none" do %>
        <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height: 250px;">
          <i class="bi bi-image fs-1 text-muted"></i>
          <span class="text-muted"><%= t('forms.labels.no_file_attached') %></span>
        </div>
      <% end %>
    <% end %>
  
    <div class="card-body d-flex flex-column">
      <!-- Caption -->
      <% if item.caption.present? %>
        <div class="mb-2">
          <p class="mb-0 text-truncate" title="caption">
            <strong><%= t('forms.labels.caption') %>:</strong> <%= strip_tags(item.caption) %>
          </p>
        </div>
      <% end %>
      
      <!-- Tags -->
      <% if item.tags.any? %>
        <div class="mb-2">
          <h6 class="mb-1"><%= t('forms.labels.tags') %>:</h6>
          <div class="d-flex flex-wrap gap-1">
            <% item.tags.each do |tag| %>
              <span class="badge bg-secondary"><%= tag.translated_name %></span>
            <% end %>
          </div>
        </div>
      <% end %>
      
      <div class="mt-auto d-flex justify-content-between align-items-center">
        <%= link_to t('forms.buttons.view_details'), item_show_path, data: { turbo_frame: "_top" }, class: "btn btn-primary btn-sm" %>
        <div class="d-flex gap-1 align-items-center">
          <% has_needtag = item.tags.any? { |t| t.name == 'needtag' } %>
          <%= button_to add_needtag_item_path(item),
                        method: :patch,
                        data: { turbo: true },
                        class: "btn btn-sm #{has_needtag ? 'btn-info' : 'btn-outline-info'}",
                        title: (has_needtag ? t('forms.tooltips.remove_needtag') : t('forms.tooltips.add_needtag')) do %>
            ?
          <% end %>

          <% has_bestof = item.tags.any? { |t| t.name == 'bestof' } %>
          <%= button_to add_bestof_item_path(item),
                        method: :patch,
                        data: { turbo: true },
                        class: "btn btn-sm #{has_bestof ? 'btn-warning' : 'btn-outline-warning'} d-flex align-items-center gap-1",
                        title: (has_bestof ? t('forms.tooltips.remove_from_best_of') : t('forms.tooltips.add_to_best_of')) do %>
            <i class="bi bi-<%= has_bestof ? 'star-fill' : 'star' %>"></i>
            <%= t('forms.labels.best_of') %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
