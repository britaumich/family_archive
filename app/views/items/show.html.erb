<div class="container mt-4">
  <div class="row">
    <div class="col-lg-8">
      <!-- Item Image/File Display -->
      <div class="card mb-4">
        <div class="card-body">
          <% if @item.file.attached? %>
            <% if @item.item_type_photo? %>
              <%= image_tag @item.file, class: "img-fluid rounded", alt: "Item image", style: "max-height: 600px; width: auto;" %>
            <% elsif @item.item_type_video? %>
              <video controls class="img-fluid rounded" style="max-height: 600px; width: auto;">
                <source src="<%= url_for(@item.file) %>" type="<%= @item.file.content_type %>">
                <%= t('views.items.show.video_not_supported') %>
              </video>
            <% elsif @item.item_type_document? %>
              <div class="text-center p-4">
                <h5><%= t('views.items.show.document') %></h5>
                <p class="text-muted">
                  <%= @item.file.filename %>
                  (<%= number_to_human_size(@item.file.byte_size) %>)
                </p>
                <%= link_to t('views.items.show.download'), @item.file, class: "btn btn-primary", download: true %>
              </div>
            <% end %>
          <% else %>
            <div class="text-center p-5">
              <p class="text-muted"><%= t('views.items.show.no_file_attached') %></p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Item Details -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">
            <%= t('views.items.show.item_details') %>
          </h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <strong><%= t('views.items.show.type') %></strong>
            <span class="badge bg-secondary ms-2">
              <%= @item.item_type.humanize %>
            </span>
          </div>

          <% if @item.caption.present? %>
            <div class="mb-3">
              <strong><%= t('views.items.show.caption') %></strong>
              <br>
              <p class="mb-0"><%= strip_tags(@item.caption) %></p>
            </div>
          <% end %>
          
          <div class="mb-3">
            <strong><%= t('views.items.show.created') %></strong>
            <br>
            <small class="text-muted">
              <%= @item.created_at.strftime("%B %d, %Y at %I:%M %p") %>
            </small>
          </div>

          <% if @item.file.attached? %>
            <div class="mb-3">
              <strong><%= t('views.items.show.file') %></strong>
              <br>
              <small class="text-muted">
                <%= @item.file.filename %><br>
                <%= number_to_human_size(@item.file.byte_size) %>
              </small>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Tags Section -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">
            <%= t('views.items.show.tags') %>
          </h5>
        </div>
        <div class="card-body">
          <% if @item.tags.any? %>
            <div class="d-flex flex-wrap gap-2">
              <% @item.tags.each do |tag| %>
                <%= link_to tag.name, items_path(tags: [tag.id]), 
                    class: "badge bg-primary text-decoration-none", 
                    style: "font-size: 0.85em; padding: 0.5em 0.75em;" %>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted mb-0">
              <%= t('views.items.show.no_tags_assigned') %>
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <!-- Action Buttons -->
      <div class="d-grid gap-2 mb-4">
        <%= link_to t('forms.buttons.edit'), edit_item_path(@item), class: "btn btn-warning" if policy(@item).edit? %>
        <% if policy(@item).destroy? %>
          <%= link_to item_path(@item), 
              class: "btn btn-danger", 
              data: { 
                turbo_confirm: t('views.items.show.delete_confirmation'),
                turbo_method: :delete
              } do %>
            <%= t('forms.buttons.delete') %>
          <% end %>
        <% end %>
        
        <%= link_to items_path, class: "btn btn-secondary" do %>
          <%= t('forms.buttons.back_to_items') %>
        <% end %>
      </div>

      <!-- Tag Assignment Section -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">
            <%= t('views.items.show.assign_tags') %>
          </h5>
        </div>
        <div class="card-body">
          <%= form_tag assign_tags_item_path(@item), method: :patch do %>
            <% if @assignment_tags_by_type.any? %>
              <% @assignment_tags_by_type.each do |tag_type, tags| %>
                <div class="mb-3">
                  <div class="card">
                    <div class="card-header">
                      <h6 class="mb-0 text-muted"><%= tag_type ? tag_type.translated_name : t('forms.labels.no_tag_type') %></h6>
                    </div>
                    <div class="card-body">
                      <div class="tag-checkboxes" style="max-height: 150px; overflow-y: auto;">
                        <% tags.each do |tag| %>
                          <div class="form-check">
                            <%= check_box_tag "tag_ids[]", tag.id, 
                                @item.tags.include?(tag), 
                                { 
                                  id: "assign_tag_#{tag.id}"
                                } %>
                            <%= label_tag "assign_tag_#{tag.id}", tag.name, class: "form-check-label" %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
              <div class="mt-3">
                <%= submit_tag t('views.items.show.assign_selected_tags'), class: "btn btn-success" %>
              </div>
            <% else %>
              <p class="text-muted"><%= t('forms.messages.no_tags_found') %></p>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Tag Removal Section -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">
            <%= t('views.items.show.remove_tags') %>
          </h5>
        </div>
        <div class="card-body">
          <% if @item.tags.any? %>
            <%= form_tag remove_tags_item_path(@item), method: :patch do %>
              <div class="mb-3">
                <h6 class="text-muted"><%= t('views.items.show.current_tags') %></h6>
                <div class="tag-checkboxes" style="max-height: 150px; overflow-y: auto;">
                  <% @item.tags.each do |tag| %>
                    <div class="form-check">
                      <%= check_box_tag "tag_ids[]", tag.id, false, 
                          { 
                            id: "remove_tag_#{tag.id}"
                          } %>
                      <%= label_tag "remove_tag_#{tag.id}", tag.name, class: "form-check-label" %>
                    </div>
                  <% end %>
                </div>
              </div>
              <div class="mt-3">
                <%= submit_tag t('views.items.show.remove_selected_tags'), class: "btn btn-danger" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted"><%= t('views.items.show.no_tags_to_remove_message') %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
