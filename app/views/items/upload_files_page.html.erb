<div class="w-100" data-controller='autosubmit'>
  <div class="d-md-flex justify-content-between align-items-center text-nowrap pb-4">
    <h1><%= t('page_titles.upload_files') %></h1>
  </div>
  <div>
    <%= turbo_frame_tag 'upload_files' do %>
      <div class="mt-2 body-md-text">
        <p><%= t('forms.labels.upload_instructions') %>
        </p>
      </div>
      <hr>
      <div class="d-flex flex-column flex-sm-row flex-wrap gap-2">
        <%= form_tag upload_files_path, 
                    method: :post, 
                    data: { turbo: false },
                    multipart: true do %>
          <div>
            <%= label_tag 'file_', t('forms.labels.choose_files'), class: "body-bold-text" %>
            <%= file_field_tag 'files[]', accept: ".jpg,.jpeg,.png", multiple: true %>
          </div>
          <div class="mt-3">
            <%= label_tag 'item_type', t('forms.labels.select_item_type'), class: "body-bold-text" %>
            <%= select_tag 'item_type', options_for_select([[t('forms.labels.item_types.photo'), 'photo'], [t('forms.labels.item_types.video'), 'video'], [t('forms.labels.item_types.document'), 'document']], 'photo'), prompt: t('forms.labels.item_types.select_prompt'), class: 'form-select' %>
          </div>
          <div class="body-bold-text mt-3">
            <%= t('forms.labels.select_tags') %>
          </div>
          <div class="row g-2">
            <% 
              safe_locale = %w[en ru].include?(I18n.locale.to_s) ? I18n.locale.to_s : 'en'
              order_clause = Arel.sql("COALESCE(name_translations->>'#{safe_locale}', name_translations->>'en', name)")
              tags = Tag.order(order_clause)
            %>
            <% tags.each do |tag| %>
              <div class="col-6 col-md-4 col-lg-3">
                <div class="form-check">
                  <%= check_box_tag "tag_ids[]", tag.id, false, id: "tag_#{tag.id}", class: "form-check-input" %>
                  <%= label_tag "tag_#{tag.id}", tag.translated_name, class: "form-check-label" %>
                </div>
              </div>
            <% end %>
          </div>
          <%= submit_tag t('forms.buttons.upload') %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
