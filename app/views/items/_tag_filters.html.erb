<!-- Filter by tags -->
<% 
  form_url = local_assigns.fetch(:form_url, editing_tags_page_items_path)
  clear_url = local_assigns.fetch(:clear_url, items_path)
  card_wrapper = local_assigns.fetch(:card_wrapper, false)
  use_turbo_frames = local_assigns.fetch(:use_turbo_frames, false)
  show_no_tags_filter = local_assigns.fetch(:show_no_tags_filter, false)
  selected_tag_ids = @selected_tags.map(&:id)
%>

<% if card_wrapper %>
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0"><%= t('forms.labels.filter_by_tags') %></h5>
    </div>
    <div class="card-body">
<% end %>

<%= form_with url: form_url, method: :get, local: false, data: { turbo_stream: true }, class: "mb-4" do |form| %>
  <% if params[:item_type].present? %>
    <%= hidden_field_tag :item_type, params[:item_type] %>
  <% end %>

  <div class="row">
    <div class="col-12">
      <h5><%= t('forms.labels.filter_by_tags') %></h5>
    </div>
  </div>
  
  <div class="row">
    <!-- Tag Types Grid -->
    <div class="col-lg-9 col-md-8">
      <div class="row g-3">
        <% @tags_by_type_filters.each do |tag_type, tags| %>
          <div class="col-xl-4 col-lg-6 col-md-12">
            <div class="card h-100">
              <div class="card-header">
                <h6 class="mb-0 text-muted">
                  <%= tag_type ? tag_type.translated_name : t('forms.labels.no_tag_type') %>
                </h6>
              </div>
              <div class="card-body">
                <!-- All tag types as checkboxes -->
                <div class="tag-checkboxes" style="max-height: 200px; overflow-y: auto;">
                  <% tags.each do |tag| %>
                    <div class="form-check">
                      <%= form.check_box :tags, 
                          { multiple: true, checked: selected_tag_ids.include?(tag.id), id: "tag_#{tag.id}" }, 
                          tag.id, "" %>
                      <%= form.label "tag_#{tag.id}", tag.translated_name, 
                          class: "form-check-label" %>
                    </div>
                  <% end %>
                </div>
                
                <!-- Display selected tags for this type -->
                <% if use_turbo_frames %>
                  <div id="badges-for-<%= tag_type&.id || 'no-type' %>" class="mt-2">
                    <%= render 'tag_type_badges', tag_type: tag_type %>
                  </div>
                <% else %>
                  <div class="mt-2">
                    <%= render 'tag_type_badges', tag_type: tag_type %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    
    <!-- Filter Type Options -->
    <div class="col-lg-3 col-md-4">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0"><%= t('forms.labels.filter_type') %></h5>
        </div>
        <div class="card-body">
          <div class="form-check mb-2">
            <%= form.radio_button :filter_type, "any", checked: params[:filter_type] == "any", class: "form-check-input" %>
            <%= form.label :filter_type_any, t('forms.labels.filter_type_any'), class: "form-check-label" %>
          </div>
          <div class="form-check">
            <%= form.radio_button :filter_type, "all", checked: params[:filter_type] != "any", class: "form-check-input" %>
            <%= form.label :filter_type_all, t('forms.labels.filter_type_all'), class: "form-check-label" %>
          </div>
          <% if show_no_tags_filter %>
            <hr>
            <div class="form-check">
              <%= form.check_box :no_tags_only, { checked: ActiveModel::Type::Boolean.new.cast(params[:no_tags_only]), class: "form-check-input" }, '1', '0' %>
              <%= form.label :no_tags_only, t('text.no_tags'), class: "form-check-label" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  
  <div class="mt-3">
    <%= form.submit t('forms.buttons.apply_filters'), class: "btn btn-primary" %>
    <%= link_to t('forms.buttons.clear_filters'), clear_url, class: "btn btn-outline-secondary" %>
    <% if use_turbo_frames %>
      <div id="filter-badges">
        <%= render 'filter_badges' %>
      </div>
    <% else %>
      <%= render 'filter_badges' %>
    <% end %>
  </div>
<% end %>

<% if card_wrapper %>
    </div>
  </div>
<% end %>
