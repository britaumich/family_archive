<% if @items.any? %>
  <div class="mb-3 d-flex align-items-center justify-content-between">
    <h2>
      <% if params[:item_type] == 'video' %>
        <%= t('menu.navbar.videos') %>
      <% elsif params[:item_type] == 'document' %>
        <%= t('menu.navbar.documents') %>
      <% else %>
        <%= t('views.items.index.pictures') %>
      <% end %>
    </h2>
  </div>
  <div class="my-2">
    <%= page_entries_info @items %>
  </div>
  <% navigation_item_ids = @items.map(&:id).join(',') %>
  <% navigation_return_path = request.fullpath %>
    <!-- Items Grid -->
  <div class="row g-4" data-controller="lightbox">
    <% @items.each do |item| %>
      <div class="col-12 col-md-6 col-lg-4 col-xl-3">
        <%= render partial: "items/item_card", locals: { item: item, navigation_item_ids: navigation_item_ids, navigation_return_path: navigation_return_path } %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-5">
    <h3 class="text-muted"><%= t('views.items.no_items_yet') %></h3>
  </div>
<% end %>
