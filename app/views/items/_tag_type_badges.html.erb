<% selected_tags_for_type = @selected_tags.select { |tag| tag.tag_type_id == tag_type&.id } %>
<% if selected_tags_for_type.any? %>
  <div class="mt-2">
    <% selected_tags_for_type.each do |tag| %>
      <span class="badge bg-primary me-1 mb-1" style="font-size: 0.75em;">
        <%= tag.name %>        
          <small>(<%= tag.items.size %>)</small>
      </span>
    <% end %>
  </div>
<% end %>
