<div class="container-fluid">
  <h1><%= t('page_titles.select_pictures_by_tags') %></h1>
  

  <% if @tags_by_type_filters.any? %>
    <%= render 'tag_filters', form_url: @form_action || items_path, clear_url: @form_action || items_path %>
  <% end %>
  <%= form_with url: @form_action || items_path, method: :get, turbo: true,
    data: { controller: "autosubmit",
            autosubmit_target: "form",
            turbo_frame: "all_items"
            } do %>
    <div class="d-flex align-items-center gap-2 mb-3">
      <label for="per" class="form-label"><%= t('forms.labels.items_per_page') %>:</label>
      <%= select_tag :per, options_for_select([25, 50, 100, 150, 200], params[:per] ? params[:per] : 100), "data-action": "autosubmit#submitForm", class: "form-select" %>
    </div>
  <% end %>
  <%= turbo_frame_tag "all_items" do %>
    <%= render 'all_items_content' %>
  <% end %>
</div>
